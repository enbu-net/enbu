{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen --clean && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
    "dev": "(panda dev & vp dev) > web.log 2>&1",
    "build": "panda codegen --clean && vp build",
    "build:preview": "panda codegen --clean && vp build --mode preview",
    "build:vscode": "panda codegen --clean && vp build --mode vscode",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test",
    "check": "vp check && vp test",
    "legacy-scan": "node scripts/legacy-scan.mjs",
    "a11y": "node scripts/a11y.mjs",
    "preview": "vp preview"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@park-ui/panda-preset": "^0.43.1",
    "@tanstack/react-router": "^1.170.17",
    "@taplo/core": "^0.2.0",
    "@taplo/lsp": "^0.8.0",
    "@wailsio/runtime": "3.0.0",
    "lucide-react": "^1.23.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.1",
    "@inlang/plugin-message-format": "4.6.0",
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@park-ui/cli": "1.0.1",
    "@tanstack/router-devtools": "1.167.3",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.0",
    "modern-web-guidance": "0.0.206",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "//": "Manage Node.js and pnpm versions only in ../aqua.yaml. Do not add engines, devEngines, or packageManager; configure Vite+ to use system tools."
}
