{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.bombadil.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "skipLibCheck": true,

    /* Bundler mode: Bombadil bundles the specification itself. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["bombadil"]
}
